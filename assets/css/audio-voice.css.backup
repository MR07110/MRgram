/* assets/css/audio-voice.css - Audio va Voice uchun bir xil stil */

.av-player {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    width: 280px;
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    transition: all 0.2s ease;
}

.av-player:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-1px);
}

/* Play button */
.av-play-btn {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #0088cc;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    cursor: pointer;
    transition: transform 0.2s ease;
}

.av-play-btn:hover {
    transform: scale(1.05);
}

.av-play-btn img {
    width: 50px;
    height: 50px;
    filter: brightness(0) invert(1);
    margin-left: 2px;
}

/* Info area */
.av-info {
    flex: 1;
    min-width: 0;
}

.av-title {
    font-size: 13px;
    font-weight: 500;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 6px;
}

/* Progress bar */
.av-progress-wrapper {
    width: 100%;
}

.av-progress-bar {
    width: 100%;
    height: 3px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 3px;
    cursor: pointer;
    position: relative;
    margin-bottom: 4px;
}

.av-progress-fill {
    height: 100%;
    background: #0088cc;
    border-radius: 3px;
    width: 0%;
    position: relative;
}

.av-progress-slider {
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 10px;
    height: 10px;
    background: #0088cc;
    border-radius: 50%;
    opacity: 0;
    transition: opacity 0.15s;
}

.av-progress-bar:hover .av-progress-slider {
    opacity: 1;
}

/* Time */
.av-time {
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    font-family: monospace;
    opacity: 0.5;
}

.av-current-time {
    color: #0088cc;
}

/* Footer */
.av-footer {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 5px;
    justify-content: flex-end;
}

.av-icon {
    opacity: 0.4;
}

.av-size {
    font-size: 9px;
    opacity: 0.35;
}

/* My message */
.me-player .av-player {
    background: rgba(0, 136, 204, 0.1);
}

/* Xabar ichida */
.msg:has(.av-player) {
    max-width: 300px !important;
    padding: 4px 10px !important;
}

/* Responsive */
@media (max-width: 600px) {
    .av-player {
        width: 240px;
        padding: 8px 12px;
        gap: 10px;
    }
    
    .av-play-btn {
        width: 38px;
        height: 38px;
    }
    
    .av-play-btn img {
        width: 16px;
        height: 16px;
    }
    
    .av-title {
        font-size: 12px;
    }
    
    .msg:has(.av-player) {
        max-width: 260px !important;
    }
}
/* SVG icon o'lchamlari - O'RTA */
.av-icon {
    width: 14px !important;
    height: 14px !important;
    transition: all 0.2s ease;
}

/* Orqa fon KO'K bo'lsa (me-voice) - icon OQ */
.me-player .av-icon {
    filter: brightness(0) invert(1) !important;
}

/* Orqa fon DARK bo'lsa (them-voice) - icon KO'K */
.them-player .av-icon {
    filter: brightness(0) saturate(100%) invert(47%) sepia(91%) saturate(1680%) hue-rotate(178deg) brightness(95%) contrast(101%) !important;
}

.av-footer {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-top: 5px;
    justify-content: flex-end;
}

.av-size {
    font-size: 9px;
    opacity: 0.4;
}
/* Play/Pause icon - OQ rang */
.av-play-btn img {
    filter: brightness(0) invert(1) !important;
}

/* Hover da ham oq qoladi */
.av-play-btn:hover img {
    filter: brightness(0) invert(1) !important;
}
